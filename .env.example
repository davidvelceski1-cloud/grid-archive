# ── Database ───────────────────────────────────────────────────────────────
# Neon / Supabase Postgres with the pgvector extension.
# DATABASE_URL: pooled connection (used by the app at runtime)
# DIRECT_URL:   direct (non-pooled) connection (used by `prisma migrate`)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Local alternative (npm run dev:db):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

# ── AI (server-side only; never prefix with NEXT_PUBLIC_) ───────────────────
# Claude powers Ask the Archive, summaries, ELI5, On-this-day and AI articles.
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-opus-5-5
CLAUDE_MODEL=""
# Voyage AI embeddings for vector search (optional — full-text search is used without it)
VOYAGE_API_KEY=""

# ── Admin & jobs ───────────────────────────────────────────────────────────
# Password for /admin (HTTP Basic auth, user "admin")
ADMIN_PASSWORD="change-me"
# Shared secret for the scheduled update job (Vercel Cron sends it as a Bearer token)
CRON_SECRET="change-me-too"

# ── Ingestion etiquette ────────────────────────────────────────────────────
# Wikimedia requires a descriptive User-Agent with a way to contact you.
HTTP_USER_AGENT="GridArchive/1.0 (https://your-site.example; you@example.com)"
# Minimum ms between requests (defaults shown)
JOLPICA_INTERVAL_MS=7500
WIKIMEDIA_INTERVAL_MS=1000

# Public site URL (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
